# Copy to .env.development / .env.staging / .env.production and fill in.
# Validated at startup by src/shared/config/env.ts.

# development | staging | production
NEXT_PUBLIC_ENV=development
# Backend base URL, no trailing slash
NEXT_PUBLIC_API_URL=http://localhost:5000
# Root domain used for subdomain routing and cookie names (e.g. prepzy.ai)
NEXT_PUBLIC_PARENT_DOMAIN=localhost
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Monitoring and analytics (optional; each is disabled when empty)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=

# Payments (optional): Razorpay public key id used by the checkout page
NEXT_PUBLIC_RAZORPAY_KEY_ID=
