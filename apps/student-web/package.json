{
  "name": "@prepzy/student-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "env-cmd -f .env.development next dev",
    "prebuild:dev": "node scripts/clean-tsconfig-includes.mjs",
    "build:dev": "env-cmd -f .env.development next build",
    "start:dev": "env-cmd -f .env.development next start",
    "prebuild:staging": "node scripts/clean-tsconfig-includes.mjs",
    "build:staging": "env-cmd -f .env.staging next build",
    "start:staging": "env-cmd -f .env.staging next start",
    "prebuild:production": "node scripts/clean-tsconfig-includes.mjs",
    "build:production": "env-cmd -f .env.production next build",
    "start:production": "env-cmd -f .env.production next start",
    "prebuild": "node scripts/clean-tsconfig-includes.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^4.6.2",
    "@hookform/resolvers": "^7.0.1",
    "@prepzy/design-system": "*",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@sentry/nextjs": "^11.10.0",
    "@tanstack/react-query": "^5.105.3",
    "@tiptap/extension-image": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "better-react-mathjax": "^3.0.3",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.67.0",
    "next": "^15.5.28",
    "posthog-js": "^1.445.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@tanstack/react-query-devtools": "^5.105.3",
    "env-cmd": "^11.0.0",
    "eslint-config-next": "^15.5.28",
    "msw": "^3.0.3",
    "tailwindcss": "^4.3.4"
  }
}
